## 15) backend/main.py

```py
from fastapi import FastAPI, HTTPException, Depends, Request
from pydantic import BaseModel
from typing import List
import sqlite3
import uuid
import time

app = FastAPI()
DB = 'shiksha.db'

# Simple helper functions (synchronous sqlite for demo)
def get_conn():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

class AuthIn(BaseModel):
    username: str

@app.post('/api/auth')
def auth(payload: AuthIn):
    # naive: create user if not exists and return token
    conn = get_conn()
    cur = conn.cursor()
    cur.execute('CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT, grade TEXT)')
    cur.execute('SELECT id FROM users WHERE username=?', (payload.username,))
    row = cur.fetchone()
    if row:
        uid = row['id']
    else:
        uid = str(uuid.uuid4())
        cur.execute('INSERT INTO users (id, username) VALUES (?,?)', (uid, payload.username))
        conn.commit()
    token = uid
    return {'token': token}

@app.get('/api/me')
def me(token: str = None):
    # token from header or query (simple demo)
    if not token:
        return {'username': 'Guest'}
    conn = get_conn()
    cur = conn.cursor()
    cur.execute('SELECT username, grade FROM users WHERE id=?', (token,))
    row = cur.fetchone()
    if not row:
        return {'username': 'Guest'}
    return {'username': row['username'], 'grade': row['grade']}

@app.get('/api/recommend')
def recommend():
    # simple placeholder: return seeded content
    return [
        {'content_id':'c1','title':'Fraction basics','score':0.92},
        {'content_id':'c2','title':'Adding fractions','score':0.86}
    ]

@app.get('/api/content/{content_id}')
def get_content(content_id: str):
    # in production fetch from DB
    sample = {
        'c1': {'content_id':'c1','title':'Fraction basics','body':'<p>Fractions are parts of whole...</p>'},
        'c2': {'content_id':'c2','title':'Adding fractions','body':'<p>To add fractions...</p>'}
    }
    return sample.get(content_id, {'content_id':content_id,'title':'Not found','body':'<p>Not found</p>'})

@app.post('/api/attempt')
def submit_attempt(payload: dict):
    # store attempt (demo)
    conn = get_conn()
    cur = conn.cursor()
    cur.execute('CREATE TABLE IF NOT EXISTS attempts (id TEXT PRIMARY KEY, user_id TEXT, content_id TEXT, correct INTEGER, ts INTEGER)')
    aid = str(uuid.uuid4())
    cur.execute('INSERT INTO attempts (id, user_id, content_id, correct, ts) VALUES (?,?,?,?,?)',
                (aid, payload.get('user_id'), payload.get('content_id'), int(payload.get('correct',0)), int(time.time())))
    conn.commit()
    return {'status':'ok'}

@app.get('/api/quiz/{quiz_id}')
def get_quiz(quiz_id: str):
    sample = {'title':'Sample Quiz','questions':[{'id':'q1','text':'2+2?','choices':['3','4','5'],'answer':1}]}
    return sample
